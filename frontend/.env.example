# ============================================================
#  frontend/.env.example
#  ✅ Safe to commit — contains NO real secrets.
#  Copy this file to .env and fill in your actual values.
# ============================================================

# ── Backend API URL ───────────────────────────────────────────
# ⚠️  IMPORTANT: This value is baked into the production bundle at BUILD TIME.
# You MUST set the correct URL in your hosting platform's environment variables
# BEFORE running `npm run build` (or before the platform builds for you).
#
# For local development:
VITE_API_URL=http://localhost:5000/api

# For production (replace with your deployed backend URL):
# VITE_API_URL=https://your-backend-domain.com/api
#
# On Vercel: set this in Project Settings → Environment Variables → Production
# On Render: set this in your service's Environment tab

