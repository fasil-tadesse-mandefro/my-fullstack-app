# ============================================================
#  backend/.env.example
#  ✅ Safe to commit — contains NO real secrets.
#  Copy this file to .env and fill in your actual values.
# ============================================================

PORT=5000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────
DB_USER=postgres
DB_HOST=localhost
DB_NAME=your_database_name
DB_PASSWORD=your_db_password_here
DB_PORT=5432

DATABASE_URL=postgresql://postgres:your_db_password_here@localhost:5432/your_database_name

# ── Security ─────────────────────────────────────────────────
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string
