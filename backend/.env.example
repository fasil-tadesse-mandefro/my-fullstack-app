# ============================================================
#  backend/.env.example
#  ✅ Safe to commit — contains NO real secrets.
#  Copy this file to .env and fill in your actual values.
# ============================================================

PORT=5000

# ── Environment ──────────────────────────────────────────────
# Set to "production" on your hosting platform (Railway, Render, Fly, etc.)
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────
DB_USER=postgres
DB_HOST=localhost
DB_NAME=your_database_name
DB_PASSWORD=your_db_password_here
DB_PORT=5432

DATABASE_URL=postgresql://postgres:your_db_password_here@localhost:5432/your_database_name

# ── Database SSL ──────────────────────────────────────────────
# Set to "true" for cloud Postgres providers: Neon, Railway, Supabase, Render, etc.
# Leave unset or "false" for local Postgres.
DB_SSL=false

# ── Security ─────────────────────────────────────────────────
# Generate a strong random string:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ⚠️  REQUIRED in production — server will refuse to start without this.
JWT_SECRET=replace_with_a_long_random_secret_string

# ── CORS ─────────────────────────────────────────────────────
# The URL of your deployed frontend (e.g. https://abugida.vercel.app).
# ⚠️  REQUIRED in production — without this, browser requests will be blocked by CORS.
# Leave unset during local development (localhost:5173 is always allowed).
FRONTEND_URL=https://your-frontend-domain.com

